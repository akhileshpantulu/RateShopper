{
  // GitHub Codespaces: open the Rate Shopper in a browser without installing anything.
  // Creating the codespace installs the package. Every time it starts it pulls the latest code from main and refreshes
  // the install, so restarting the codespace is all it takes to update. Each time you open it, the web app starts.
  "name": "Rate Shopper",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "containerEnv": {
    "GOOGLE_HOTELS_COUNTRY": "gb",
    "DEFAULT_CURRENCY": "GBP"
  },
  "postCreateCommand": "pip install --no-cache-dir -e . && mkdir -p data",
  "postStartCommand": "bash .devcontainer/update.sh",
  "postAttachCommand": {
    "rate-shopper": "bash .devcontainer/start-web.sh"
  },
  "forwardPorts": [8765],
  "portsAttributes": {
    "8765": {
      "label": "Rate Shopper",
      "onAutoForward": "openBrowser"
    }
  },
  "customizations": {
    "codespaces": {
      "openFiles": ["docs/CODESPACES.md"]
    }
  }
}
